# Normalise to LF in the repository. CI runs on Linux (.github/workflows/gates.yml)
# and Godot's own text formats are LF; letting Windows CRLF into the index produces
# spurious whole-file diffs and can break shell scripts on the runner.
* text=auto eol=lf

# Windows-only scripts keep CRLF on checkout.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Godot text resources
*.tscn   text eol=lf
*.tres   text eol=lf
*.godot  text eol=lf
*.import text eol=lf
*.uid    text eol=lf

# Binary assets — never diff or convert these.
*.png  binary
*.jpg  binary
*.webp binary
*.ogg  binary
*.wav  binary
*.mp3  binary
*.ttf  binary
*.otf  binary
*.aseprite binary
*.ase  binary
